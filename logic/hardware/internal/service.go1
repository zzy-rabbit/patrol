package internal

import (
	"context"
	"github.com/google/uuid"
	"github.com/zzy-rabbit/patrol/model"
	"github.com/zzy-rabbit/xtools/xerror"
	"github.com/zzy-rabbit/xtools/xfile"
	"github.com/zzy-rabbit/xtools/xtrace"
	"os"
	"path/filepath"
)

func (s *service) AddHardware(ctx context.Context, department string, hardware model.Hardware) (model.Identify, xerror.IError) {
	defer xtrace.Trace(ctx)(department, hardware)
	if hardware.ID == "" {
		hardware.ID = uuid.New().String()
	}
	database, ok := s.IDatabase.Get(ctx, department)
	if !ok {
		s.ILogger.Error(ctx, "department %s database not found", department)
		return model.Identify{}, xerror.Extend(xerror.ErrNotFound, "department %s", department)
	}

	hardware.Content = s.buildQrCodeContent(ctx, hardware)
	_, xerr := database.GetDB(ctx).AddHardware(ctx, hardware)
	if xerror.Error(xerr) {
		s.ILogger.Error(ctx, "department %s add hardware %+v fail %v", department, hardware, xerr)
		return model.Identify{}, xerr
	}
	return hardware.Identify, nil
}

func (s *service) UpdateHardware(ctx context.Context, department string, hardware model.Hardware) xerror.IError {
	defer xtrace.Trace(ctx)(department, hardware)
	database, ok := s.IDatabase.Get(ctx, department)
	if !ok {
		s.ILogger.Error(ctx, "department %s database not found", department)
		return xerror.Extend(xerror.ErrNotFound, "department %s", department)
	}
	return database.GetDB(ctx).UpdateHardware(ctx, hardware)
}

func (s *service) DeleteHardwares(ctx context.Context, department string, hardwares ...model.Identify) xerror.IError {
	defer xtrace.Trace(ctx)(department, hardwares)
	database, ok := s.IDatabase.Get(ctx, department)
	if !ok {
		s.ILogger.Error(ctx, "department %s database not found", department)
		return xerror.Extend(xerror.ErrNotFound, "department %s", department)
	}
	return database.GetDB(ctx).DeleteHardwares(ctx, hardwares...)
}

func (s *service) GetHardwares(ctx context.Context, department string, condition model.HardwareCondition) ([]model.Hardware, model.PageInfo, xerror.IError) {
	defer xtrace.Trace(ctx)(department, condition)
	database, ok := s.IDatabase.Get(ctx, department)
	if !ok {
		s.ILogger.Error(ctx, "department %s database not found", department)
		return nil, model.PageInfo{}, xerror.Extend(xerror.ErrNotFound, "department %s", department)
	}
	return database.GetDB(ctx).GetHardwares(ctx, condition)
}

func (s *service) ExportHardwares(ctx context.Context, department string, identifies ...model.Identify) (string, xerror.IError) {
	defer xtrace.Trace(ctx)(department, identifies)

	ids := make([]string, len(identifies))
	for i, identify := range identifies {
		ids[i] = identify.ID
	}
	hardwares, _, xerr := s.GetHardwares(ctx, department, model.HardwareCondition{IDs: ids})
	if xerror.Error(xerr) {
		s.ILogger.Error(ctx, "department %s get hardwares %v fail %v", department, ids, xerr)
		return "", xerr
	}

	if xfile.IsExist(ctx, s.config.Path) {
		err := os.RemoveAll(s.config.Path)
		if xerror.Error(err) {
			s.ILogger.Error(ctx, "department %s remove path %s fail %v", department, s.config.Path, err)
			return "", xerror.Extend(xerror.ErrFileOperationFail, "department %s remove path %s fail %v", department, s.config.Path, err)
		}
	}

	err := os.MkdirAll(s.config.Path, os.ModePerm)
	if xerror.Error(err) {
		s.ILogger.Error(ctx, "department %s create path %s fail %v", department, s.config.Path, err)
		return "", xerror.Extend(xerror.ErrFileOperationFail, "department %s create path %s fail %v", department, s.config.Path, err)
	}

	filePaths := make([]string, 0, len(hardwares))
	for _, hardware := range hardwares {
		if hardware.Type != model.HardwareTypeQrcode {
			continue
		}

		filePath := filepath.Join(s.config.Path, hardware.ID+".png")
		xerr = s.IQrcode.BuildAndSave(ctx, hardware.Content, 256, filePath)
		if xerror.Error(xerr) {
			s.ILogger.Error(ctx, "department %s build qrcode %s fail %v", department, hardware.Content, xerr)
			return "", xerr
		}
		filePaths = append(filePaths, filePath)
	}

	if len(filePaths) <= 0 {
		xerr = xerror.Extend(xerror.ErrInvalidParam, "no valid qrcode content was selected")
		s.ILogger.Error(ctx, "department %s identifies %+v %v", department, identifies, xerr)
		return "", xerr
	}

	// todo: zip

	return "", nil
}
