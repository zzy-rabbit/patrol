package internal

import (
	"context"
	"fmt"
	"github.com/zzy-rabbit/patrol/model"
)

func (s *service) buildQrCodeContent(ctx context.Context, hardware model.Hardware) string {
	switch hardware.Type {
	case model.HardwareTypeQrcode:
		return fmt.Sprintf("http://%s:%d/patrol/page/v1/qrcode?id=%s", s.config.Host, s.config.Port, hardware.ID)
	case model.HardwareTypeNFC:
		return ""
	}
	return ""
}
